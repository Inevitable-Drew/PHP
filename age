<!DOCTYPE html>
<html>
<head>

</head>
	<body>
		<input id="num" Placeholder="Enter your age"/>
		<button onclick="gilfunction()">Click Here</button>
		<p id="java3"></p>
			
		<script>
			function gilfunction(){
				var num;
				num = document.getElementById("num").value;
				if (num >=1 && num<=10){
					document.getElementById("java3").innerHTML ="Within the range of 1-10 years old";
				}
				else if(num >=11 && num<=20){
					document.getElementById("java3").innerHTML ="Within the range of 11-20 years old";
				}
				else if(num >=21 && num<=30){
					document.getElementById("java3").innerHTML ="Within the range of 21-30 years old";
				}
				else if(num >=31 && num<=40){
					document.getElementById("java3").innerHTML ="Within the range of 31-40 years old";
				}
				else if(num >=41 && num<=50){
					document.getElementbyId("java3").innerHTML ="Within the range of 41-50 years old";
				}
				else {
					document.getElementById("java3").innerHTML ="Unidentified age";
				}
			}
		</script>
		
	</body>
</html>
